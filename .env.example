# 环境变量清单（模板，不含任何真实值）。
#
# 用法：
#   Linux/bash  : export $(grep -v '^#' .env | xargs)    或 systemd 的 EnvironmentFile=.env
#   Windows PS  : Get-Content .env | ForEach-Object { ... } 或直接 set 变量
# 说明：服务本身**不解析** .env（刻意不引入 python-dotenv，减少依赖），
#       变量必须由 shell / 进程管理器注入到进程环境里。

# --- QQ 开放平台机器人凭据 ---
# 变量名与 config.toml 的 qq.app_id_env / qq.app_secret_env 对应（默认即下面这两个名字）。
QQ_BOT_APP_ID=
QQ_BOT_APP_SECRET=

# --- RCON 密码 ---
# 命名约定 MC_RCON_PASSWORD_<服务器名大写，非字母数字换成下划线>，
# 与 config.toml 的 mc_servers[].password_env 对应；
# 未设置对应变量时回退 MC_RCON_PASSWORD。
MC_RCON_PASSWORD_MAIN=
MC_RCON_PASSWORD=
